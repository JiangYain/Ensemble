{
  "name": "ensemble-plugin",
  "version": "0.1.0",
  "description": "Delegate work to full Cursor, Codex, Pi, Claude Code, OpenCode and DSH harness sessions, then watch and steer them live.",
  "keywords": [
    "agent-plugin",
    "mcp",
    "mcp-server",
    "delegation",
    "sub-agent",
    "harness",
    "cursor",
    "codex",
    "claude-code",
    "opencode",
    "orchestration"
  ],
  "homepage": "https://github.com/JiangYain/Ensemble#readme",
  "bugs": {
    "url": "https://github.com/JiangYain/Ensemble/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JiangYain/Ensemble.git"
  },
  "license": "MIT",
  "author": "Chord",
  "type": "module",
  "bin": {
    "ensemble": "dist/ensemble.mjs"
  },
  "files": [
    "dist/",
    "plugin.json",
    "mcp.json",
    ".mcp.json",
    ".cursor-plugin/",
    "skills/",
    "assets/",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:server": "node scripts/build.mjs --server",
    "build:web": "node scripts/build.mjs --web",
    "check:package": "node scripts/check-package.mjs",
    "prepublishOnly": "npm run build && node scripts/check-package.mjs --clean",
    "dev:service": "tsx --tsconfig tsconfig.node.json src/cli/main.ts serve --dev",
    "dev:web": "vite --config vite.config.ts",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json && tsc -p tsconfig.web.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/ensemble.mjs serve",
    "mcp": "node dist/ensemble.mjs mcp"
  },
  "devDependencies": {
    "@cursor/sdk": "1.3.1",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "ajv": "8.20.0",
    "esbuild": "0.28.2",
    "happy-dom": "21.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vestig": "0.24.1",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "zod": "4.6.7"
  }
}
